{
  "target": "http://localhost:3000",
  "out": "capture-scratch",
  "port": 3101,
  "width": 390,
  "height": 844,
  "captureHeight": 800,
  "hide": ["nextjs-portal"],
  "prepare": [ { "method": "POST", "path": "/api/reset" } ],
  "states": [
    { "name": "01-home", "path": "/play", "run": "await __wait('.nav'); await __sleep(1500);" },
    { "name": "02-menu", "path": "/play", "run": "await __wait('.nav'); document.querySelectorAll('.nav button')[1].click(); await __wait('.menu');" }
  ]
}
